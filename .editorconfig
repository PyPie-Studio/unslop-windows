root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
end_of_line = unset

[*.bat]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
